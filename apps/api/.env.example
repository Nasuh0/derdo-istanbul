NODE_ENV=development
PORT=3000
TRUST_PROXY=false

DATABASE_URL=postgresql://derdo:derdo_dev_password@localhost:5432/derdo?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-a-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=derdo-api
JWT_AUDIENCE=derdo-web

BCRYPT_ROUNDS=12
REFRESH_COOKIE_NAME=derdo_refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
CORS_ORIGINS=http://localhost:5173,https://derdoistanbul.com,https://www.derdoistanbul.com

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=dev-secret-change-this-before-production
LIVEKIT_TOKEN_TTL_SECONDS=300
