generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum RoomType {
  PUBLIC
  PRIVATE
}

enum RoomMemberRole {
  OWNER
  MEMBER
}

model User {
  id               String   @id @default(uuid())
  username         String   @unique @db.VarChar(32)
  passwordHash     String   @map("password_hash") @db.VarChar(100)
  refreshTokenHash String?  @map("refresh_token_hash") @db.VarChar(64)
  role             UserRole @default(USER)
  isBanned         Boolean  @default(false) @map("is_banned")
  tokenVersion     Int      @default(0) @map("token_version")
  lastLoginAt      DateTime? @map("last_login_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  createdRooms       ChatRoom[] @relation("RoomCreator")
  roomMemberships    ChatRoomMember[]
  messages           ChatMessage[]
  dmMemberships      DirectConversationMember[]
  directMessages     DirectMessage[]
  voiceMemberships   VoiceChannelMember[]
  attachments        Attachment[] @relation("AttachmentUploader")
  auditLogs          AuditLog[] @relation("AuditActor")

  @@map("users")
}

model ChatRoom {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(64)
  slug        String   @unique @db.VarChar(64)
  type        RoomType @default(PRIVATE)
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy User? @relation("RoomCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members   ChatRoomMember[]
  messages  ChatMessage[]

  @@index([type])
  @@map("chat_rooms")
}

model ChatRoomMember {
  roomId   String         @map("room_id")
  userId   String         @map("user_id")
  role     RoomMemberRole @default(MEMBER)
  joinedAt DateTime       @default(now()) @map("joined_at")

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId])
  @@map("chat_room_members")
}

model ChatMessage {
  id        String   @id @default(uuid())
  roomId    String   @map("room_id")
  authorId  String   @map("author_id")
  content   String   @db.VarChar(4000)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  room        ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([roomId, createdAt])
  @@index([authorId])
  @@map("chat_messages")
}

model DirectConversation {
  id        String   @id @default(uuid())
  pairKey   String   @unique @map("pair_key") @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members  DirectConversationMember[]
  messages DirectMessage[]

  @@map("direct_conversations")
}

model DirectConversationMember {
  conversationId String   @map("conversation_id")
  userId         String   @map("user_id")
  joinedAt       DateTime @default(now()) @map("joined_at")

  conversation DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("direct_conversation_members")
}

model DirectMessage {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  authorId       String   @map("author_id")
  content        String   @db.VarChar(4000)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  conversation DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([conversationId, createdAt])
  @@index([authorId])
  @@map("direct_messages")
}

model VoiceChannel {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(64)
  slug      String   @unique @db.VarChar(64)
  type      RoomType @default(PUBLIC)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members VoiceChannelMember[]

  @@index([type])
  @@map("voice_channels")
}

model VoiceChannelMember {
  channelId String   @map("channel_id")
  userId    String   @map("user_id")
  joinedAt  DateTime @default(now()) @map("joined_at")

  channel VoiceChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId])
  @@map("voice_channel_members")
}

model Attachment {
  id              String   @id @default(uuid())
  uploaderId      String   @map("uploader_id")
  chatMessageId   String?  @map("chat_message_id")
  directMessageId String?  @map("direct_message_id")
  provider        String   @default("cloudinary") @db.VarChar(32)
  publicId        String   @unique @map("public_id") @db.VarChar(255)
  url             String   @db.Text
  mimeType        String   @map("mime_type") @db.VarChar(64)
  sizeBytes       Int      @map("size_bytes")
  originalName    String   @map("original_name") @db.VarChar(255)
  width           Int?
  height          Int?
  createdAt       DateTime @default(now()) @map("created_at")

  uploader      User           @relation("AttachmentUploader", fields: [uploaderId], references: [id], onDelete: Cascade)
  chatMessage   ChatMessage?   @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)
  directMessage DirectMessage? @relation(fields: [directMessageId], references: [id], onDelete: Cascade)

  @@index([uploaderId, createdAt])
  @@index([chatMessageId])
  @@index([directMessageId])
  @@map("attachments")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  action     String   @db.VarChar(80)
  targetType String   @map("target_type") @db.VarChar(80)
  targetId   String?  @map("target_id") @db.VarChar(80)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
  @@map("audit_logs")
}
